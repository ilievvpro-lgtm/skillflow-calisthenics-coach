# Copy to .env (never commit .env). Set ONE of the providers below.

# Option A: Anthropic API directly (used whenever this is set)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Option B: Vercel AI Gateway (used when ANTHROPIC_API_KEY is empty).
# Not needed on Vercel deployments: the OIDC token is injected automatically.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-opus-5.5
